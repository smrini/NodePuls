# ==================================
# HOMELAB DASHBOARD - CONFIGURATION EXAMPLE
# ==================================
# Copy this file to .env and customize the values for your environment
# This file contains ALL available configuration options with detailed explanations

# ==================================
# SERVER CONFIGURATION
# ==================================

# PORT - The port number where the server will run
# Default: 3020
# Range: 1-65535
# Note: In Docker, this is typically 3020, in development you might use 3000-3999
PORT=3020

# NODE_ENV - Application environment mode
# Values: development, production, test
# Default: development
# Note: Controls optimization levels, logging, and error handling
NODE_ENV=production

# CORS_ORIGIN - Cross-Origin Resource Sharing allowed origins
# Default: Auto-generated based on PORT (http://localhost:PORT)
# Examples: 
#   Single origin: http://localhost:3020
#   Multiple origins: http://localhost:3020,http://127.0.0.1:3020,http://192.168.1.100:3020
#   All origins (insecure): *
# CORS_ORIGIN=http://localhost:3020

# ==================================
# DATABASE CONFIGURATION
# ==================================

# DB_PATH - Path to SQLite database file
# Default: ./server/data/homelab.db (development), /app/data/homelab.db (Docker)
# Note: Ensure the directory exists and is writable
DB_PATH=./server/data/homelab.db

# ==================================
# MONITORING CONFIGURATION
# ==================================

# MONITOR_INTERVAL - How often to collect system metrics (milliseconds)
# Default: 5000 (5 seconds)
# Minimum: 1000 (1 second)
# Note: Lower values provide more real-time data but use more CPU
MONITOR_INTERVAL=5000

# CLEANUP_INTERVAL - How often to clean up old data (hours)
# Default: 24 (daily cleanup)
# Minimum: 1 hour
# Note: Prevents database from growing too large
CLEANUP_INTERVAL=24

# DEFAULT_TIMEOUT - Default timeout for HTTP requests (milliseconds)
# Default: 10000 (10 seconds)
# Note: Used for website monitoring and API calls
DEFAULT_TIMEOUT=10000

# MAX_HISTORY_ENTRIES - Maximum number of historical data points to keep
# Default: 100
# Note: Higher values use more memory but provide longer history
MAX_HISTORY_ENTRIES=100

# WEBSITE_DOWN_THRESHOLD - Number of consecutive failures before marking site as down
# Default: 3
# Note: Reduces false positives from temporary network issues
WEBSITE_DOWN_THRESHOLD=3

# SYSTEM_UPDATE_INTERVAL - How often to update system statistics (milliseconds)
# Default: 5000 (5 seconds)
# Note: Should match MONITOR_INTERVAL for consistency
SYSTEM_UPDATE_INTERVAL=5000

# WEBSITE_CHECK_INTERVAL - Cron expression for website monitoring schedule
# Default: "*/1 * * * *" (every minute)
# Examples:
#   Every 30 seconds: "*/30 * * * * *"
#   Every 5 minutes: "*/5 * * * *"
#   Every hour: "0 * * * *"
WEBSITE_CHECK_INTERVAL="*/1 * * * *"

# WEBSITE_CHECK_TIMEOUT - Timeout for individual website checks (milliseconds)
# Default: 5000 (5 seconds)
# Note: Should be less than WEBSITE_CHECK_INTERVAL
WEBSITE_CHECK_TIMEOUT=5000

# MAX_HISTORY_LENGTH - Maximum number of system metric history points
# Default: 60
# Note: At 5-second intervals, this provides 5 minutes of history
MAX_HISTORY_LENGTH=60

# MAX_WEBSITE_HISTORY - Maximum number of website check history points
# Default: 1440 (24 hours of minute-by-minute data)
# Note: Higher values provide longer uptime history but use more storage
MAX_WEBSITE_HISTORY=1440

# ==================================
# FEATURE FLAGS
# ==================================

# ENABLE_CPU_TEMPERATURE - Enable CPU temperature monitoring
# Default: true
# Note: May not work on all systems or in containers
ENABLE_CPU_TEMPERATURE=true

# ENABLE_DISK_IO_MONITORING - Enable disk I/O statistics
# Default: false
# Note: Can be resource intensive on busy systems
ENABLE_DISK_IO_MONITORING=false

# ENABLE_PROCESS_MONITORING - Enable process list monitoring
# Default: false
# Note: Requires elevated privileges, useful for debugging
ENABLE_PROCESS_MONITORING=false

# ENABLE_EMAIL_NOTIFICATIONS - Enable email notifications for alerts
# Default: false
# Note: Requires additional email configuration (SMTP settings)
ENABLE_EMAIL_NOTIFICATIONS=false

# ==================================
# SECURITY CONFIGURATION
# ==================================

# ENABLE_HELMET - Enable Helmet.js security headers
# Default: true
# Note: Adds security headers like CSP, HSTS, etc.
ENABLE_HELMET=true

# TRUST_PROXY - Trust proxy headers (X-Forwarded-For, etc.)
# Default: false
# Note: Set to true if behind a reverse proxy (nginx, Apache, etc.)
TRUST_PROXY=false

# ==================================
# LOGGING CONFIGURATION
# ==================================

# LOG_LEVEL - Logging verbosity level
# Values: error, warn, info, verbose, debug, silly
# Default: info
# Note: Higher levels (debug, silly) provide more details but more noise
LOG_LEVEL=info

# ENABLE_DEBUG_LOGGING - Enable detailed debug logging
# Default: false
# Note: Very verbose, only use for troubleshooting
ENABLE_DEBUG_LOGGING=false

# ==================================
# PROXY/DOMAIN CONFIGURATION
# ==================================

# DASHBOARD_DOMAIN - Domain name for the dashboard
# Default: localhost
# Examples: dashboard.homelab.local, 192.168.1.100, mydashboard.com
# Note: Used for generating URLs and CORS settings
DASHBOARD_DOMAIN=localhost

# ENABLE_HTTPS_REDIRECT - Automatically redirect HTTP to HTTPS
# Default: false
# Note: Only enable if you have SSL certificates configured
ENABLE_HTTPS_REDIRECT=false

# ==================================
# SYSTEM PATHS (ADVANCED)
# ==================================

# PROC_PATH - Path to /proc filesystem (Linux/Docker)
# Default: /proc
# Note: Used for system monitoring, change only if using custom mounts
PROC_PATH=/proc

# SYS_PATH - Path to /sys filesystem (Linux/Docker)
# Default: /sys
# Note: Used for hardware information, change only if using custom mounts
SYS_PATH=/sys

# ==================================
# PERFORMANCE SETTINGS
# ==================================

# COMPRESSION_LEVEL - Gzip compression level for HTTP responses
# Default: 6
# Range: 0-9 (0=no compression, 9=maximum compression)
# Note: Higher levels use more CPU but reduce bandwidth
COMPRESSION_LEVEL=6

# REQUEST_TIMEOUT - HTTP request timeout (milliseconds)
# Default: 10000 (10 seconds)
# Note: How long to wait for responses from external services
REQUEST_TIMEOUT=10000

# MAX_CONNECTIONS - Maximum concurrent connections
# Default: 100
# Note: Limits resource usage, adjust based on available memory
MAX_CONNECTIONS=100

# ==================================
# REACT CLIENT CONFIGURATION
# ==================================
# Note: These variables are embedded at build time for React apps
# Changes require rebuilding the client application

# REACT_APP_SERVER_PORT - Server port for client connections (fallback)
# Default: Uses PORT value
# Note: Only used if dynamic configuration fails
# REACT_APP_SERVER_PORT=3020

# REACT_APP_API_BASE_URL - Base URL for API calls
# Default: Auto-generated from server configuration
# Examples: http://localhost:3020, https://dashboard.example.com
# Note: Override only if using custom proxy setup
# REACT_APP_API_BASE_URL=http://localhost:3020

# REACT_APP_SOCKET_URL - WebSocket server URL for real-time updates
# Default: Auto-generated from server configuration
# Note: Should match REACT_APP_API_BASE_URL in most cases
# REACT_APP_SOCKET_URL=http://localhost:3020

# REACT_APP_CHART_UPDATE_INTERVAL - How often to update charts (milliseconds)
# Default: 5000 (5 seconds)
# Note: Should match MONITOR_INTERVAL for smooth updates
REACT_APP_CHART_UPDATE_INTERVAL=5000

# REACT_APP_DEFAULT_TIME_RANGE - Default time range for charts (minutes)
# Default: 60 (1 hour)
# Note: Users can change this in the UI
REACT_APP_DEFAULT_TIME_RANGE=60

# ==================================
# DEFAULT WEBSITES TO MONITOR
# ==================================

# DEFAULT_WEBSITES - JSON array of websites to monitor on first run
# Default: [] (empty array)
# Format: [{"name": "Google", "url": "https://google.com"}, {"name": "GitHub", "url": "https://github.com"}]
# Note: Websites can also be added through the web interface
DEFAULT_WEBSITES=[]

# ==================================
# EMAIL NOTIFICATION SETTINGS (Optional)
# ==================================
# Uncomment and configure these if ENABLE_EMAIL_NOTIFICATIONS=true

# SMTP_HOST - SMTP server hostname
# Examples: smtp.gmail.com, smtp.outlook.com, mail.yourdomain.com
# SMTP_HOST=smtp.gmail.com

# SMTP_PORT - SMTP server port
# Common values: 587 (TLS), 465 (SSL), 25 (unencrypted)
# SMTP_PORT=587

# SMTP_SECURE - Use SSL/TLS encryption
# Values: true, false
# SMTP_SECURE=true

# SMTP_USER - SMTP authentication username (usually email address)
# SMTP_USER=your-email@gmail.com

# SMTP_PASS - SMTP authentication password or app password
# Note: Use environment-specific secrets in production
# SMTP_PASS=your-app-password

# EMAIL_FROM - "From" address for notification emails
# EMAIL_FROM=nodepuls@yourdomain.com

# EMAIL_TO - Comma-separated list of recipient emails
# EMAIL_TO=admin@yourdomain.com,alerts@yourdomain.com

# ==================================
# ADVANCED DOCKER SETTINGS
# ==================================
# These are typically set in docker-compose.yml rather than .env

# Container resource limits (set in docker-compose.yml)
# - CPU limits
# - Memory limits
# - Restart policies

# Security settings (set in docker-compose.yml)
# - User/group IDs
# - Capability restrictions
# - Read-only root filesystem

# Volume mounts (set in docker-compose.yml)
# - Host system monitoring paths
# - Persistent data directories
# - Log directories

# ==================================
# TROUBLESHOOTING
# ==================================

# If the dashboard isn't working:
# 1. Check PORT is not in use by another service
# 2. Verify DB_PATH directory exists and is writable
# 3. Enable debug logging with ENABLE_DEBUG_LOGGING=true
# 4. Check CORS_ORIGIN matches your access URL
# 5. Ensure all required Docker volumes are mounted

# For performance issues:
# 1. Increase MONITOR_INTERVAL and SYSTEM_UPDATE_INTERVAL
# 2. Reduce MAX_HISTORY_ENTRIES and MAX_HISTORY_LENGTH
# 3. Disable unused features (CPU_TEMPERATURE, DISK_IO_MONITORING)
# 4. Adjust COMPRESSION_LEVEL based on CPU vs bandwidth priorities

# For security hardening:
# 1. Enable ENABLE_HELMET=true
# 2. Set specific CORS_ORIGIN (avoid *)
# 3. Use HTTPS with ENABLE_HTTPS_REDIRECT=true
# 4. Set TRUST_PROXY=true only if behind reverse proxy
# 5. Use LOG_LEVEL=warn or error in production
