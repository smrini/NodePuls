# ==================================
# HOMELAB DASHBOARD - CONFIGURATION EXAMPLE
# ==================================
# Copy this file to .env and modify the values as needed
# This file shows all available configuration options

# ==================================
# SERVER CONFIGURATION
# ==================================
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ==================================
# CLIENT CONFIGURATION
# ==================================
CLIENT_PORT=3000
REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000
REACT_APP_CHART_UPDATE_INTERVAL=5000
REACT_APP_DEFAULT_TIME_RANGE=60

# ==================================
# DATABASE CONFIGURATION
# ==================================
DB_PATH=./server/data/homelab.db

# ==================================
# MONITORING CONFIGURATION
# ==================================
MONITOR_INTERVAL=5000
CLEANUP_INTERVAL=24
DEFAULT_TIMEOUT=10000
MAX_HISTORY_ENTRIES=100
WEBSITE_DOWN_THRESHOLD=3

# System monitoring settings
SYSTEM_UPDATE_INTERVAL=5000
WEBSITE_CHECK_INTERVAL="*/1 * * * *"
WEBSITE_CHECK_TIMEOUT=5000
MAX_HISTORY_LENGTH=60
MAX_WEBSITE_HISTORY=1440

# Feature flags
ENABLE_CPU_TEMPERATURE=true
ENABLE_DISK_IO_MONITORING=false
ENABLE_PROCESS_MONITORING=false
ENABLE_EMAIL_NOTIFICATIONS=false

# ==================================
# SECURITY CONFIGURATION
# ==================================
ENABLE_HELMET=true
TRUST_PROXY=false

# ==================================
# LOGGING CONFIGURATION
# ==================================
LOG_LEVEL=info
ENABLE_DEBUG_LOGGING=false

# ==================================
# PROXY/DOMAIN CONFIGURATION
# ==================================
DASHBOARD_DOMAIN=localhost
ENABLE_HTTPS_REDIRECT=false

# ==================================
# SYSTEM PATHS (Linux/Docker)
# ==================================
PROC_PATH=/proc
SYS_PATH=/sys

# ==================================
# PERFORMANCE SETTINGS
# ==================================
COMPRESSION_LEVEL=6
REQUEST_TIMEOUT=10000
MAX_CONNECTIONS=100

# ==================================
# DEFAULT WEBSITES TO MONITOR
# ==================================
# Format: [{"name": "Site Name", "url": "https://example.com"}]
# Example: DEFAULT_WEBSITES=[{"name": "Google", "url": "https://google.com"}, {"name": "GitHub", "url": "https://github.com"}]
DEFAULT_WEBSITES=[]
