server/data/homelab.db.backup
server/data/*.db
!server/data/homelab.db
server/data/*.sqlite
server/data/*.sqlite3

# Build outputs
client/build/
server/public/
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# nyc test coverage
.nyc_output

# Dependency directories
node_modules/
jspm_packages/

# Optional npm cache directory
.npm

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Note: .env files are tracked as they contain only non-sensitive configuration
# Remove the duplicate .env patterns below

