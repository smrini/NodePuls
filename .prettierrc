{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf",
  "vueIndentScriptAndStyle": false,
  "singleAttributePerLine": false,
  "overrides": [
    { "files": ["*.css"], "options": { "singleQuote": false } },
    { "files": ["*.md"], "options": { "printWidth": 80, "proseWrap": "always" } }
  ]
}
