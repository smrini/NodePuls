# ==================================
# CLIENT-SPECIFIC CONFIGURATION
# ==================================
# This file inherits from the main .env file at the root
# Override any client-specific settings here

# React app settings
REACT_APP_API_BASE_URL=http://localhost:3050
REACT_APP_SOCKET_URL=http://localhost:3050
REACT_APP_CHART_UPDATE_INTERVAL=5000
REACT_APP_DEFAULT_TIME_RANGE=60

# Development settings
PORT=3040
BROWSER=none
FAST_REFRESH=true

# Build settings
GENERATE_SOURCEMAP=true
BUILD_PATH=build
