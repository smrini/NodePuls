# ==================================
# CLIENT ENVIRONMENT EXAMPLE
# ==================================
# Copy this file to .env in the client folder and modify as needed

# React app settings
REACT_APP_API_BASE_URL=http://localhost:4000
REACT_APP_SOCKET_URL=http://localhost:4000
REACT_APP_CHART_UPDATE_INTERVAL=5000
REACT_APP_DEFAULT_TIME_RANGE=60

# Development settings
PORT=3000
BROWSER=none
FAST_REFRESH=true

# Build settings
GENERATE_SOURCEMAP=true
BUILD_PATH=build
