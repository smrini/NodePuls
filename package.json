{
	"name": "homelab-dashboard",
	"version": "1.0.0",
	"description": "Lightweight homelab server dashboard with uptime monitoring and resource tracking",
	"main": "server/index.js",
	"scripts": {
		"dev": "concurrently \"npm run server\" \"npm run client\"",
		"server": "nodemon server/index.js",
		"client": "cd client && npm start",
		"build": "cd client && npm run build",
		"build:prod": "cd client && npm run build && xcopy /E /Y build\\* ..\\server\\public\\",
		"start": "node server/index.js",
		"start:prod": "npm run build:prod && npm start",
		"install:all": "npm install && cd client && npm install",
		"validate-env": "node validate-env.js"
	},
	"keywords": [
		"homelab",
		"dashboard",
		"monitoring",
		"uptime",
		"server"
	],
	"author": "Your Name",
	"license": "MIT",
	"dependencies": {
		"axios": "^1.5.0",
		"compression": "^1.7.4",
		"cors": "^2.8.5",
		"dotenv": "^17.0.1",
		"express": "^4.18.2",
		"helmet": "^7.0.0",
		"node-cron": "^3.0.2",
		"socket.io": "^4.7.2",
		"sqlite3": "^5.1.7",
		"systeminformation": "^5.21.8"
	},
	"devDependencies": {
		"concurrently": "^8.2.1",
		"cross-env": "^7.0.3",
		"nodemon": "^3.0.1"
	}
}
