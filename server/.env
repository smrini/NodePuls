# ==================================
# SERVER-SPECIFIC CONFIGURATION
# ==================================
# This file inherits from the main .env file at the root
# Override any server-specific settings here

# NOTE: PORT should NOT be set here in Docker environment
# Let Docker environment variables take precedence
# PORT is set via docker-compose.yml environment section

# Database path (relative to server directory)
DB_PATH=./data/homelab.db

# Monitoring intervals (can be server-specific)
SYSTEM_UPDATE_INTERVAL=5000
WEBSITE_CHECK_TIMEOUT=10000
