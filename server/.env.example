# ==================================
# SERVER ENVIRONMENT EXAMPLE
# ==================================
# Copy this file to .env in the server folder and modify as needed

# Server settings
PORT=3050
NODE_ENV=development

# Database
DB_PATH=./data/homelab.db

# CORS settings
CORS_ORIGIN=http://localhost:3000

# Monitoring intervals
SYSTEM_UPDATE_INTERVAL=5000
WEBSITE_CHECK_TIMEOUT=5000
